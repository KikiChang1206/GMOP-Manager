# ============================================================
# 固定取件機器人 — 環境設定範本
# 複製這份為 .env 後填入實際值。切勿把 .env 提交到 git。
#   cp .env.example .env
# ============================================================

# ---------- 表單伺服器 ----------
# 客人設定表單 / 管理者檢視頁 的埠號
PORT=3000
# 管理者檢視頁的存取密碼(進 /admin 需要)。請改成自己的密碼。
ADMIN_PASSWORD=change-me

# ---------- 資料儲存後端 ----------
# local        = 存到本機 JSON 檔(預設,免任何外部設定,立即可用)
# google-sheets = 存到 Google Sheet(需下方憑證,之後要用再切換)
DATASTORE=local

# --- 只有 DATASTORE=google-sheets 時才需要以下設定 ---
# Google 試算表 ID(網址中 /d/ 後面那段)
GOOGLE_SHEET_ID=
# 服務帳戶金鑰 JSON 檔路徑
GOOGLE_CREDENTIALS_PATH=./google-credentials.json
# 兩個分頁名稱(對應設計文件 Sheet1 / Sheet2)
GOOGLE_SHEET_CUSTOMERS_TAB=客人設定主表
GOOGLE_SHEET_LOGS_TAB=執行記錄表

# ---------- GoodMaji 系統登入 ----------
GOODMAJI_URL=https://system.goodmaji.com
GOODMAJI_USERNAME=
GOODMAJI_PASSWORD=

# ---------- 通知 ----------
# LINE Messaging API(沿用既有 Bot 的 channel access token)
LINE_CHANNEL_ACCESS_TOKEN=
# 要收到彙總通知的對象 userId / groupId(多個用逗號分隔)
LINE_NOTIFY_TARGETS=

# Email 通知(選填,留空則不寄信)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# ---------- 執行行為 ----------
# 每筆固定填入的值(對應設計文件第8節)
DEFAULT_PACKAGE_COUNT=0
DEFAULT_NOTE=件數確認中
# Playwright 是否無頭執行(1=headless,0=顯示瀏覽器方便除錯)
HEADLESS=1
# 單一操作逾時(毫秒)
STEP_TIMEOUT_MS=15000
