# ============================================================
#  機密設定 (請複製成 .env 並填入實際值，切勿 commit 進 git)
# ============================================================

# ---- 目標系統登入 ----
GMOP_BASE_URL=https://system.goodmaji.com
GMOP_LOGIN_URL=https://system.goodmaji.com/web/login.aspx
GMOP_USERNAME=請填入帳號
GMOP_PASSWORD=請填入密碼

# ---- Email 通知 (SMTP) ----
# 若用 Gmail：SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
#   SMTP_PASSWORD 請用「應用程式密碼」(App Password)，不是登入密碼。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=請填入寄件信箱
SMTP_PASSWORD=請填入SMTP密碼或應用程式密碼
MAIL_FROM=請填入寄件信箱
MAIL_TO=op2@goodmaji.com
